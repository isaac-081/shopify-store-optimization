<section class="optimized-product-highlights">
  <div class="page-width">

    <div class="optimized-product-highlights__header">
      {% if section.settings.eyebrow != blank %}
        <p class="optimized-product-highlights__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      <h2>{{ section.settings.heading }}</h2>

      {% if section.settings.description != blank %}
        <div class="optimized-product-highlights__description">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="optimized-product-highlights__grid">

      {% for block in section.blocks %}
        <div
          class="product-highlight"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.icon != blank %}
            <div class="product-highlight__icon">
              {{ block.settings.icon }}
            </div>
          {% endif %}

          <h3>{{ block.settings.heading }}</h3>

          {% if block.settings.description != blank %}
            <p>{{ block.settings.description }}</p>
          {% endif %}

        </div>
      {% endfor %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Product Highlights",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why customers choose us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you need, made simple"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Highlight the key benefits that help customers feel confident before making a purchase.</p>"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quality Products"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Thoughtfully selected products designed for everyday use."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Highlights",
      "blocks": [
        {
          "type": "highlight"
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "⚡",
            "heading": "Fast Delivery",
            "description": "Get your order delivered quickly and reliably."
          }
        },
        {
          "type": "highlight",
          "settings": {
            "icon": "🔒",
            "heading": "Secure Shopping",
            "description": "Shop confidently with a secure checkout experience."
          }
        }
      ]
    }
  ]
}
{% endschema %}
